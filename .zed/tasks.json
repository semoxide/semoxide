// Run the hook tools from Zed (task palette).
[
  {
    "label": "markdownlint: fix current file",
    "command": "markdownlint-cli2",
    "args": ["--fix", "$ZED_FILE"]
  },
  {
    "label": "typos: current file",
    "command": "typos",
    "args": ["$ZED_FILE"]
  },
  {
    "label": "nextest: workspace",
    "command": "cargo",
    "args": ["nextest", "run", "--workspace"]
  }
]
