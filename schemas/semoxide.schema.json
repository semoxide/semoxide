{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "BranchRule": {
      "description": "A branch name (a release branch), a release or prerelease table, or a maintenance table.",
      "else": {
        "else": {
          "additionalProperties": false,
          "description": "A release branch, or a prerelease branch with `prerelease`.",
          "properties": {
            "channel": {
              "anyOf": [
                {
                  "const": false
                },
                {
                  "minLength": 1,
                  "pattern": "^([^{}]|\\{name\\})*$",
                  "type": "string"
                }
              ],
              "description": "The release channel: `false` for the default channel, or a name that may contain `{name}`. Unset: the default channel for the first release branch, the branch name for the others."
            },
            "name": {
              "description": "The branch name or a glob; a name shaped like a range (`1.x`) is a maintenance rule instead.",
              "not": {
                "pattern": "^[0-9]+(\\.([0-9]+|[xX]))?\\.[xX]$"
              },
              "type": "string"
            },
            "prerelease": {
              "anyOf": [
                {
                  "const": true
                },
                {
                  "pattern": "^(0|[1-9][0-9]*|([0-9A-Za-z-]|\\{name\\})*([A-Za-z-]|\\{name\\})([0-9A-Za-z-]|\\{name\\})*)(\\.(0|[1-9][0-9]*|([0-9A-Za-z-]|\\{name\\})*([A-Za-z-]|\\{name\\})([0-9A-Za-z-]|\\{name\\})*))*$",
                  "type": "string"
                }
              ],
              "description": "`true` for the branch name as the identifier, or an identifier that may contain `{name}`."
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "if": {
          "required": [
            "maintenance"
          ],
          "type": "object"
        },
        "then": {
          "additionalProperties": false,
          "description": "A maintenance branch.",
          "else": {
            "required": [
              "range"
            ]
          },
          "if": {
            "properties": {
              "maintenance": {
                "pattern": "(N\\.x|N\\.x\\.x|N\\.N\\.x)$"
              }
            }
          },
          "properties": {
            "channel": {
              "anyOf": [
                {
                  "const": false
                },
                {
                  "minLength": 1,
                  "pattern": "^([^{}]|\\{name\\})*$",
                  "type": "string"
                }
              ],
              "description": "The release channel: `false` for the default channel, or a name that may contain `{name}`. Unset: the default channel for the first release branch, the branch name for the others."
            },
            "maintenance": {
              "description": "A pattern ending in `N.x`, `N.x.x` or `N.N.x`, or a branch name with `range`.",
              "type": "string"
            },
            "range": {
              "description": "The versions of a named maintenance branch: `1.x`, `1.x.x` or `1.2.x`.",
              "pattern": "^[0-9]+(\\.([0-9]+|[xX]))?\\.[xX]$",
              "type": "string"
            }
          },
          "required": [
            "maintenance"
          ],
          "then": {
            "not": {
              "required": [
                "range"
              ]
            }
          },
          "type": "object"
        }
      },
      "if": {
        "type": "string"
      },
      "then": {
        "not": {
          "pattern": "^[0-9]+(\\.([0-9]+|[xX]))?\\.[xX]$"
        },
        "type": "string"
      }
    },
    "Branches": {
      "additionalProperties": false,
      "description": "Which branches release, and how.",
      "properties": {
        "rules": {
          "default": [
            {
              "maintenance": "N.x"
            },
            "master",
            "main",
            "next",
            "next-major",
            {
              "name": "beta",
              "prerelease": true
            },
            {
              "name": "alpha",
              "prerelease": true
            }
          ],
          "description": "The branch rules in order; the first release branch is the main line.",
          "items": {
            "$ref": "#/definitions/BranchRule"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "type": "object"
    },
    "Commits": {
      "additionalProperties": false,
      "description": "How commits are read.",
      "properties": {
        "preset": {
          "default": "conventionalcommits",
          "description": "The commit convention both bundled plugins use; `conventionalcommits` marks breaking changes with `!`.",
          "enum": [
            "conventionalcommits",
            "angular"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "ConfigDomain": {
      "additionalProperties": false,
      "description": "How the configuration itself is assembled.",
      "properties": {
        "merge": {
          "default": "deep",
          "description": "How a domain from a later layer (an `extends` source, the file) combines with an earlier one: key by key, or replacing the whole domain.",
          "enum": [
            "deep",
            "shallow"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "PluginConfig": {
      "additionalProperties": true,
      "description": "Settings of one plugin; any other keys are the plugin's own options.",
      "properties": {
        "show_output": {
          "default": false,
          "description": "Show the plugin's captured output live.",
          "type": "boolean"
        },
        "timeouts": {
          "additionalProperties": false,
          "description": "Per-step deadline overrides.",
          "properties": {
            "add_channel": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "analyze_commits": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "fail": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "generate_notes": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "prepare": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "publish": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "success": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "verify_conditions": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            },
            "verify_release": {
              "description": "The deadline for this step: a whole number and `s`, `m` or `h`, e.g. `30m`.",
              "pattern": "^0*[1-9][0-9]*[smh]$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "version": {
          "description": "The pinned plugin version; `semoxide sync` downloads it.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Secrets": {
      "additionalProperties": false,
      "description": "Extra values to mask in all output.",
      "properties": {
        "mask_env": {
          "default": [],
          "description": "Names of environment variables whose values are masked.",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Steps": {
      "additionalProperties": false,
      "description": "The enabled plugins, their order per step, and how `success` errors end a run.",
      "properties": {
        "add_channel": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "analyze_commits": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "fail": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "generate_notes": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "plugins": {
          "default": [
            "commit-analyzer",
            "release-notes"
          ],
          "description": "The enabled plugins, in run order.",
          "items": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "prepare": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "publish": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "success": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "errors": {
              "default": "warn",
              "description": "What a failing `success` step does to a published release: warn and exit 0, or fail with the partial-failure exit code (no rollback).",
              "enum": [
                "warn",
                "fail"
              ],
              "type": "string"
            },
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "verify_conditions": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "verify_release": {
          "additionalProperties": false,
          "description": "Settings of one step.",
          "properties": {
            "order": {
              "description": "The plugin order for this step; only plugins in `steps.plugins`.",
              "items": {
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Tags": {
      "additionalProperties": false,
      "description": "How release tags are named.",
      "properties": {
        "format": {
          "default": "v{version}",
          "description": "The tag name; `{version}` marks the version and appears exactly once.",
          "pattern": "\\{version\\}",
          "type": "string"
        },
        "metadata": {
          "description": "A template appended as `+<metadata>` to the git tag only, e.g. `{{ commit.short_sha }}`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "VersionDomain": {
      "additionalProperties": false,
      "description": "The first release version and the release levels on 0.x.",
      "properties": {
        "initial": {
          "default": "1.0.0",
          "description": "The version of the first release: full SemVer, without build metadata.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
          "type": "string"
        },
        "zero": {
          "$ref": "#/definitions/ZeroLevels"
        }
      },
      "type": "object"
    },
    "ZeroLevels": {
      "additionalProperties": false,
      "description": "The release level each kind of change gets while the version is 0.x.",
      "properties": {
        "breaking": {
          "default": "minor",
          "description": "The level of a breaking change on 0.x; `major` lets the first one release 1.0.0.",
          "enum": [
            "major",
            "minor",
            "patch"
          ],
          "type": "string"
        },
        "feature": {
          "default": "patch",
          "description": "The level of a feature on 0.x.",
          "enum": [
            "major",
            "minor",
            "patch"
          ],
          "type": "string"
        },
        "fix": {
          "default": "patch",
          "description": "The level of a fix on 0.x.",
          "enum": [
            "major",
            "minor",
            "patch"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "description": "semoxide's release configuration (`semoxide.toml`).",
  "properties": {
    "branches": {
      "$ref": "#/definitions/Branches"
    },
    "commits": {
      "$ref": "#/definitions/Commits"
    },
    "config": {
      "$ref": "#/definitions/ConfigDomain"
    },
    "plugins": {
      "additionalProperties": {
        "$ref": "#/definitions/PluginConfig"
      },
      "description": "Settings per enabled plugin, keyed by its short name (`[plugins.github]`).",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "secrets": {
      "$ref": "#/definitions/Secrets"
    },
    "steps": {
      "$ref": "#/definitions/Steps"
    },
    "tags": {
      "$ref": "#/definitions/Tags"
    },
    "version": {
      "$ref": "#/definitions/VersionDomain"
    }
  },
  "title": "semoxide.toml",
  "type": "object"
}
